<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:paddingTop="6dp" android:paddingBottom="6dp" android:gravity="center_vertical" android:layoutDirection="rtl">
    <TextView android:id="@+id/check" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
        android:text="◯" android:textSize="20sp" android:textColor="#0F62FE" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
        <TextView android:id="@+id/text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#111827" android:textSize="14sp" android:textDirection="rtl" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#6B7280" android:textSize="12sp" android:textDirection="rtl" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
